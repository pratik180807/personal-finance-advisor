# Flask Environment (production / development)
FLASK_ENV=production

# Security Keys (Generate strong random 32+ character strings for production)
SECRET_KEY=your_production_secret_key_here
JWT_SECRET_KEY=your_production_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database URL
# For Local Development: leave empty or use sqlite:///finance_advisor.db
# For Production (Render PostgreSQL): postgresql://user:password@host:port/dbname
DATABASE_URL=

# CORS Configuration (comma-separated list of allowed origins, or * for permissive)
CORS_ORIGINS=*

# Optional AI API Key (Gemini 1.5). Leave blank to use the built-in deterministic rule engine
AI_API_KEY=
AI_PROVIDER=gemini

# Automatically create the demo account if the database is newly initialized
AUTO_SEED_DEMO=true
